{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["eslint", "typescript", "vue", "import"],
  "rules": {
    "no-console": "off",
    "no-alert": "off"
  },
  "ignorePatterns": ["node_modules/", "dist/", ".nuxt/", ".output/"]
}
