# Created by .ignore support plugin (hsz.mobi)
### Node template
# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt
.output

# Nuxt generate
dist

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# IDE / Editor
.idea

# Service worker
sw.*

# macOS
.DS_Store

# Vim swap files
*.swp

# iOS (generated by XcodeGen / xcodebuild)
ios/Betty.xcodeproj
ios/.derived*
# Generated App Store screenshot artifacts (tooling lives in ios/screenshots/)
ios/.shots/

# ── Secrets — NEVER commit (this is a PUBLIC, open-source repo). See CLAUDE.md. ──
# Signing keys / certificates
*.jks
*.keystore
*.p12
*.p8
*.pem
*.cer
# Service-account / Firebase-admin / Google-services credential files
*service-account*.json
*serviceaccount*.json
*-adminsdk-*.json
google-services.json
GoogleService-Info.plist
# Local secret bundles + env overrides
**/.playstore-secrets/
.env.local
.env.*.local
# Stray local tooling (don't vendor SDKs into the repo)
/google-cloud-sdk/
