<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".app.BettyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Betty">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Betty">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme deep links: betty://join/{code}, betty://group/{id}, etc. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="betty" />
            </intent-filter>

            <!-- Universal links for invite URLs (requires assetlinks.json on betty.social). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="betty.social"
                    android:pathPrefix="/dashboard/groups/join" />
            </intent-filter>

            <!-- Google sign-in OAuth redirect (reversed client id of AppConfig.GOOGLE_OAUTH_CLIENT_ID).
                 Keep this scheme in sync with AppConfig.googleOAuthRedirectScheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.googleusercontent.apps.812539187075-1ijbvedesug3dl8mtbvfnoh0rrvcblpe" />
            </intent-filter>
        </activity>

        <!-- FCM message + registration-token delivery (the iOS MessagingDelegate analogue).
             Only ever invoked when Firebase is configured (google-services.json present). -->
        <service
            android:name=".core.push.BettyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Channel + monochrome icon for OS-rendered (backgrounded) tray notifications. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="betty.reminders" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_betty" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/betty_orange" />
    </application>
</manifest>
